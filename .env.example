# Public values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Keep false until Auth users, organization memberships, and employee links
# have been verified in the production project.
NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=false

# Public organization UUID used to select one membership deterministically.
NEXT_PUBLIC_SUPABASE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
